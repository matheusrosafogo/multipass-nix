-        throw mp::SSHException("[sftp] server init failed: 'Null client message'");
-    }
-
-    if (msg->type != SSH_FXP_INIT)
-    {
-        throw mp::SSHException(fmt::format(
-            "[sftp] server init failed: 'FATAL: Packet read of type {} instead of SSH_FXP_INIT'",
